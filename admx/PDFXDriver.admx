<?xml version="1.0" encoding="utf-8"?>
<!--  (c) 2014-23 Tracker Software Products (Canada) Ltd.  -->
<policyDefinitions	xmlns:xsd="http://www.w3.org/2001/XMLSchema"
					xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
					revision="1.0"
					xsi:schemaLocation=""
					schemaVersion="1.0"
					xmlns="http://www.microsoft.com/GroupPolicy/PolicyDefinitions">

	<policyNamespaces>
		<target prefix="pxce" namespace="TrackerSoftware.PDFXDriver.Policies" />
		<using prefix="products" namespace="Microsoft.Policies.Products"/>
	</policyNamespaces>

	<resources minRequiredRevision="1.0" fallbackCulture="en-us"/>

	<supportedOn>
		<products>
			<product name="PDFXDriver" displayName="$(string.PDFXDriver)">
				<majorVersion name="PDFXDriver10_1" displayName="$(string.PDFXDriver1)" versionIndex="1">
					<minorVersion name="PDFXDriver10_1_0" displayName="$(string.PDFXDriver2)" versionIndex="0"/>
				</majorVersion>
			</product>
		</products>
		<definitions>
			<definition name="SupportedOn_1011" displayName="$(string.SupportedOn_1011)">
				<and>
					<range ref="PDFXDriver" minVersionIndex="1"/>
				</and>
			</definition>
		</definitions>
	</supportedOn>

	<categories>
		<category name="Cat_PDFXDriver_1" displayName="$(string.Cat_PDFXDriver_1)" />

		<category name="Cat_Registration_1" displayName="$(string.Cat_Registration_1)">
			<parentCategory ref="Cat_PDFXDriver_1" />
		</category>
	</categories>

	<policies>
		<!-- Copy Serial -->
		<policy name="Policy_CanCopySerial" class="Machine"
				displayName="$(string.Policy_CanCopySerial)" explainText="$(string.Policy_CanCopySerial_exp)"
				key="Software\Policies\Tracker Software\PDFXDriver\10.0\Registration"
				valueName="b.CanCopySerials">
			<parentCategory ref="Cat_Registration_1"/>
			<supportedOn ref="SupportedOn_1011"/>
			<enabledValue >
				<decimal value="1" />
			</enabledValue>
			<disabledValue >
				<decimal value="0" />
			</disabledValue>
		</policy>

		<!-- Delete Serial -->
		<policy name="Policy_CanDeleteSerial" class="Machine"
				displayName="$(string.Policy_CanDeleteSerial)" explainText="$(string.Policy_CanDeleteSerial_exp)"
				key="Software\Policies\Tracker Software\PDFXDriver\10.0\Registration"
				valueName="b.CanDeleteSerials">
			<parentCategory ref="Cat_Registration_1"/>
			<supportedOn ref="SupportedOn_1011"/>
			<enabledValue >
				<decimal value="1" />
			</enabledValue>
			<disabledValue >
				<decimal value="0" />
			</disabledValue>
		</policy>

		<!-- Add Serial -->
		<policy name="Policy_CanAddSerial" class="Machine"
				displayName="$(string.Policy_CanAddSerial)" explainText="$(string.Policy_CanAddSerial_exp)"
				key="Software\Policies\Tracker Software\PDFXDriver\10.0\Registration"
				valueName="b.CanAddSerials">
			<parentCategory ref="Cat_Registration_1"/>
			<supportedOn ref="SupportedOn_1011"/>
			<enabledValue >
				<decimal value="1" />
			</enabledValue>
			<disabledValue >
				<decimal value="0" />
			</disabledValue>
		</policy>
	</policies>
</policyDefinitions>
