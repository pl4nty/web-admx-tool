  <policyNamespaces>
    <target namespace="BrowserExtension" prefix="browserextension"/>
  </policyNamespaces>
  <resources minRequiredRevision="1.0"/>
  <categories>
    <category name="BrowserExtensions" displayName="$(string.BrowserExtensions)"/>
  </categories>
  <policies/>
</policyDefinitions>
