	<presentation id="expl_RestoreACPowerThreshold">	
		<decimalTextBox refId="PSRestorePowerThreshold" defaultValue="1" spinStep="1">Restaurar o valor do limiar de alimentação CA (digite 0 para não forçar um valor):</decimalTextBox>	
		
	  <text>Restaurar o limite do limiar da alimentação CA:</text>			
		<decimalTextBox refId="PSRestorePowerThresholdLimitMin" defaultValue="1" spinStep="1">Valor mínimo (digite de 1 até o valor máximo ou 0 para não forçar um valor):</decimalTextBox>
	  <text></text>	 
		<decimalTextBox refId="PSRestorePowerThresholdLimitMax" defaultValue="100" spinStep="1">Valor máximo (digite um valor maior que o valor mínimo ou 0 para não forçar um valor):</decimalTextBox>	  
    </presentation>
	
