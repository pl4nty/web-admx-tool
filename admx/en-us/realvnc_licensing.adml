          <label>Value</label>
          <defaultValue></defaultValue>
        </textBox>
      </presentation>
      <presentation id="RealVNC_vncserver_Machine_vncserverlicense_6x">
        <textBox refId="Value">
          <label>Value</label>
          <defaultValue></defaultValue>
        </textBox>
      </presentation>         
      <presentation id="RealVNC_vncserver_Machine_blocknonpolicyservers">
      </presentation>       
    </presentationTable>
