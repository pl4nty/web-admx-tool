     <string id="AppTrustManagerList">Trusted Application List: </string>
     <string id="AppTrustManagerDesc">Enable this option and input the name of the trusted application in the list. The listed application will be added in Preferences > Trusted Manager > Change settings(2nd) > Apps in PhantomPDF.</string>
     <string id="PREF_HideActivationCode">Hide Activation Code</string>
     <string id="PREF_HideActivationCode_Explain">Enable this option to hide activation code in the application.</string>
     <string id="RMS_IRM_PROTECTION_V1">Microsoft IRM Protection V1</string>
     <string id="RMS_IRM_PROTECTION_V2">Microsoft IRM Protection V2</string>
