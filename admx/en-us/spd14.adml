      <string id="L_DefaultSecondarySchema">Default Secondary Schema</string>
      <string id="L_DefaultSecondarySchemaExplain">Set the default schema to be used when an unrecognized, or no doctype is in the page. The schema drives IntelliSense, HTML property grid and compatibility checking.</string>
