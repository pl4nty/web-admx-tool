<?xml version="1.0" encoding="utf-8"?>
<policyDefinitionResources revision="1.0" schemaVersion="1.0" xmlns="http://www.microsoft.com/GroupPolicy/PolicyDefinitions">
  <!--Adobe Acrobat Google Chrome extension efaidnbmnnnibpcajpcglclefindmkaj version: 26.9.3.0-->
  <displayName>Adobe Acrobat (Google Chrome)</displayName>
  <description>Policies for the Adobe Acrobat extension for Google Chrome, generated from its managed storage schema</description>
  <resources>
    <stringTable>
      <string id="extension_OpenHelpx">Open helpx tab.</string>
      <string id="extension_OpenHelpx_Explain">If set to false then it won't open helpx.</string>
      <string id="extension_UsageMeasurement">Turn on/off usage Analytics</string>
      <string id="extension_UsageMeasurement_Explain">To disable usage measurement, set UsageMeasurement to false in the group policy.</string>
      <string id="extension_UninstallPopup">Show/Hide Uninstall popup for free users</string>
      <string id="extension_UninstallPopup_Explain">To disable uninstall popup after user becomes free, set UninstallPopup to false</string>
      <string id="extension_DisableGenAI">Disable GenAI features</string>
      <string id="extension_DisableGenAI_Explain">To disable GenAI features, set DisableGenAI to true</string>
      <string id="extension_DisableWhatsNewAutoOpen">Disable auto-opening of What's New page</string>
      <string id="extension_DisableWhatsNewAutoOpen_Explain">To disable the auto-opening of the What's New page, set DisableWhatsNewAutoOpen to true</string>
      <string id="extension_DisableExpress">Disable Express features</string>
      <string id="extension_DisableExpress_Explain">To disable Express features for Edit Image, set DisableExpress to true.</string>
      <string id="extension_DisableShareTextToWhatsApp">Disable Share text to WhatsApp option</string>
      <string id="extension_DisableShareTextToWhatsApp_Explain">To disable the &quot;Share text to WhatsApp&quot; option in the PDF viewer context menu, set DisableShareTextToWhatsApp to true.</string>
      <string id="SUPPORTED_EXTENSION">Adobe Acrobat extension for Google Chrome</string>
      <string id="extension">Adobe Acrobat</string>
    </stringTable>
    <presentationTable>
      <presentation id="extension_OpenHelpx">
        <textBox refId="extension_OpenHelpx_Part">
          <label>Open helpx tab.</label>
        </textBox>
      </presentation>
      <presentation id="extension_UsageMeasurement">
        <textBox refId="extension_UsageMeasurement_Part">
          <label>Turn on/off usage Analytics</label>
        </textBox>
      </presentation>
      <presentation id="extension_UninstallPopup">
        <textBox refId="extension_UninstallPopup_Part">
          <label>Show/Hide Uninstall popup for free users</label>
        </textBox>
      </presentation>
      <presentation id="extension_DisableGenAI">
        <textBox refId="extension_DisableGenAI_Part">
          <label>Disable GenAI features</label>
        </textBox>
      </presentation>
      <presentation id="extension_DisableWhatsNewAutoOpen">
        <textBox refId="extension_DisableWhatsNewAutoOpen_Part">
          <label>Disable auto-opening of What's New page</label>
        </textBox>
      </presentation>
      <presentation id="extension_DisableExpress">
        <textBox refId="extension_DisableExpress_Part">
          <label>Disable Express features</label>
        </textBox>
      </presentation>
      <presentation id="extension_DisableShareTextToWhatsApp">
        <textBox refId="extension_DisableShareTextToWhatsApp_Part">
          <label>Disable Share text to WhatsApp option</label>
        </textBox>
      </presentation>
    </presentationTable>
  </resources>
</policyDefinitionResources>
