<?xml version="1.0" encoding="utf-8"?>
<policyDefinitionResources revision="1.0" schemaVersion="1.0" xmlns="http://www.microsoft.com/GroupPolicy/PolicyDefinitions">
  <!--Ghostery Google Chrome extension mlomiejdfkolichcflejclcbmpeaniij version: 10.6.6-->
  <displayName>Ghostery (Google Chrome)</displayName>
  <description>Policies for the Ghostery extension for Google Chrome, generated from its managed storage schema</description>
  <resources>
    <stringTable>
      <string id="extension_disableOnboarding">Disable onboarding process</string>
      <string id="extension_disableOnboarding_Explain">Automatically enables the extension without showing the onboarding process</string>
      <string id="extension_disableUserControl">Disable user control</string>
      <string id="extension_disableUserControl_Explain">Prevents access to the settings page and hides UI elements that allow the user to interact with the extension</string>
      <string id="extension_disableUserAccount">Disable user account</string>
      <string id="extension_disableUserAccount_Explain">Prevents the user from creating an account or logging in</string>
      <string id="extension_disableTrackersPreview">Disable trackers preview</string>
      <string id="extension_disableTrackersPreview_Explain">Prevents the user from viewing the trackers wheel on SERPs</string>
      <string id="extension_trustedDomains">Trusted domains</string>
      <string id="extension_trustedDomains_Explain">Defines a list of domains that are trusted by default</string>
      <string id="extension_customFilters">Custom filters</string>
      <string id="extension_customFilters_Explain">Defines a list of custom filters to be applied</string>
      <string id="SUPPORTED_EXTENSION">Ghostery extension for Google Chrome</string>
      <string id="extension">Ghostery</string>
    </stringTable>
    <presentationTable>
      <presentation id="extension_trustedDomains">
        <listBox refId="extension_trustedDomains_Part">Trusted domains</listBox>
      </presentation>
      <presentation id="extension_customFilters">
        <listBox refId="extension_customFilters_Part">Custom filters</listBox>
      </presentation>
    </presentationTable>
  </resources>
</policyDefinitionResources>
