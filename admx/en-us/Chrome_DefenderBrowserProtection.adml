<policyDefinitionResources revision="1.0" schemaVersion="1.0" xmlns="http://www.microsoft.com/GroupPolicy/PolicyDefinitions">
  <!--Microsoft Defender Browser Protection Google Chrome extension bkbeeeffjjeopflfhgeknacdieedcoml version: 1.664-->
  <displayName>Microsoft Defender Browser Protection (Google Chrome)</displayName>
  <description>Policies for the Microsoft Defender Browser Protection extension for Google Chrome, generated from its managed storage schema</description>
  <resources>
    <stringTable>
      <string id="extension_HideProtectionToggle">Hide Protection Toggle</string>
      <string id="extension_HideProtectionToggle_Explain">If set to true, the user will not have the option to toggle protection off using a checkbox in the flyout.</string>
      <string id="extension_PreventBlockOverride">Prevent Block Override</string>
      <string id="extension_PreventBlockOverride_Explain">If set to true, the user will not have the option to 'click through' block pages.</string>
      <string id="SUPPORTED_EXTENSION">Microsoft Defender Browser Protection extension for Google Chrome</string>
      <string id="extension">Microsoft Defender Browser Protection</string>
    </stringTable>
    <presentationTable/>
  </resources>
</policyDefinitionResources>
