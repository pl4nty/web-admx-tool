  <resources>
    <stringTable>
      <string id="extension_GrammarlyEnrollmentToken">GrammarlyEnrollmentToken</string>
      <string id="extension_GrammarlyEnrollmentToken_Explain">By default, Grammarly’s extension is enabled for all users. To disable the extension for all users except those who are logged in to your Grammarly Business account, specify your organization ID in this property.</string>
      <string id="extension_GrammarlyBlockedClients">GrammarlyBlockedClients</string>
      <string id="extension_GrammarlyBlockedClients_Explain">A comma-separated list of blocked clients.</string>
      <string id="extension_GrammarlyBlockedDomains">GrammarlyBlockedDomains</string>
      <string id="extension_GrammarlyBlockedDomains_Explain">A comma-separated list of blocked domains.</string>
      <string id="extension_GrammarlyConfidentialModeEnabled">GrammarlyConfidentialModeEnabled</string>
      <string id="extension_GrammarlyConfidentialModeEnabled_Explain">Enables the confidential mode support for GMail.</string>
      <string id="extension_GrammarlyDlpEnabled">GrammarlyDlpEnabled</string>
      <string id="extension_GrammarlyDlpEnabled_Explain">Enables the data leak/loss prevention capabilities.</string>
      <string id="extension_GrammarlyExtensionMode">GrammarlyExtensionMode</string>
      <string id="extension_GrammarlyExtensionMode_Explain">Enables type of extension work with desktop integration full or limited</string>
      <string id="SUPPORTED_EXTENSION">Grammarly browser extension</string>
      <string id="extension">Grammarly</string>
