[*.]example.edu</string>
      <string id="LocalNetworkBlockedForUrlsDesc">Block sites from making network requests to local network endpoints</string>
      <string id="LoopbackNetworkAllowedForUrls">Allow sites to make network requests to the local device</string>
      <string id="LoopbackNetworkAllowedForUrls_Explain">LoopbackNetworkAllowedForUrls

