      <string id="extension_domainSquatting_deviationThreshold">Deviation Threshold</string>
      <string id="extension_domainSquatting_deviationThreshold_Explain">Maximum number of character differences (Levenshtein distance) to trigger detection. Lower values are stricter.

Default: 2</string>
      <string id="extension_domainSquatting_algorithms_levenshtein">Levenshtein Distance</string>
      <string id="extension_domainSquatting_algorithms_levenshtein_Explain">Detect domains with small character differences

Default: true</string>
      <string id="extension_domainSquatting_algorithms_homoglyph">Homoglyph Detection</string>
      <string id="extension_domainSquatting_algorithms_homoglyph_Explain">Detect confusable characters (e.g., 'a' vs 'а')

Default: true</string>
      <string id="extension_domainSquatting_algorithms_typosquat">Typosquatting Detection</string>
      <string id="extension_domainSquatting_algorithms_typosquat_Explain">Detect common typing mistakes and character swaps

