      <string id="extension_domainSquatting_protectedDomains">Additional Protected Domains</string>
      <string id="extension_domainSquatting_protectedDomains_Explain">OPTIONAL: Additional domains to protect beyond those automatically extracted from the URL allowlist. Normally you should just add domains to the URL allowlist instead.</string>
      <string id="extension_domainSquatting_Action">Action</string>
      <string id="extension_domainSquatting_Action_Explain">Action to take when domain squatting is detected

Allowed values: &quot;block&quot;, &quot;warn&quot;, &quot;log&quot;

Default: &quot;block&quot;</string>
      <string id="extension_domainSquatting_Action_Item0">block</string>
