<?xml version="1.0" encoding="utf-8"?>
<policyDefinitionResources revision="1.0" schemaVersion="1.0" xmlns="http://www.microsoft.com/GroupPolicy/PolicyDefinitions">
  <!--LanguageTool hfjadhjooeceemgojogkhlppanjkbobc version: 11.4.0 generator: 16028ff8aa75-->
  <displayName>LanguageTool</displayName>
  <description>Policies for the LanguageTool browser extension, generated from its managed storage schema</description>
  <resources>
    <stringTable>
      <string id="extension_loginUrl">Login URL</string>
      <string id="extension_loginUrl_Explain">LanguageTool Enterprise supports OpenID/ADFS/oAuth-managed logins. Usually requires apiServerUrl to be also set. Defaults to LanguageTool's own login server. Contact support@languagetoolplus.com for more information.</string>
      <string id="extension_apiServerUrl">Custom Server URL</string>
      <string id="extension_apiServerUrl_Explain">Check texts against your own LanguageTool server. Defaults to LanguageTool's own login server. Contact support@languagetoolplus.com for more information.</string>
      <string id="extension_disablePrivacyConfirmation">Hide privacy confirmation dialog</string>
      <string id="extension_disablePrivacyConfirmation_Explain">Set this to 'true' if your users should not see the privacy confirmation dialog during installation. Defaults to 'false'.</string>
      <string id="extension_disablePersonalDictionary">Disable Personal Dictionary</string>
      <string id="extension_disablePersonalDictionary_Explain">Set this to 'true' if you do not want your users to be able to add words to their dictionary. Defaults to 'false'.</string>
      <string id="extension_disableIgnoredRules">Disable Ignored Rules</string>
      <string id="extension_disableIgnoredRules_Explain">Set this to 'true' if you do not want your users to be able to ignore grammar rules. Defaults to 'false'.</string>
      <string id="extension_disableOpenInEditor">Disable 'Open in Editor'</string>
      <string id="extension_disableOpenInEditor_Explain">Set this to 'true' if you do not want your users to be able to open texts in the Editor on languagetool.org. Defaults to 'false'.</string>
      <string id="extension_allowedURLs">Maintain a list of allowed URLs</string>
      <string id="extension_allowedURLs_Explain">Add URLs here if you do not want your users to be able to check texts on sites that aren't exlicitly allowed. Defaults to an empty list.</string>
      <string id="SUPPORTED_EXTENSION">LanguageTool browser extension</string>
      <string id="extension">LanguageTool</string>
    </stringTable>
    <presentationTable>
      <presentation id="extension_loginUrl">
        <textBox refId="extension_loginUrl_Part">
          <label>Login URL</label>
        </textBox>
      </presentation>
      <presentation id="extension_apiServerUrl">
        <textBox refId="extension_apiServerUrl_Part">
          <label>Custom Server URL</label>
        </textBox>
      </presentation>
      <presentation id="extension_allowedURLs">
        <listBox refId="extension_allowedURLs_Part">Maintain a list of allowed URLs</listBox>
      </presentation>
    </presentationTable>
  </resources>
</policyDefinitionResources>
