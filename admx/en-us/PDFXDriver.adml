							schemaVersion="1.0"
							xsi:schemaLocation=""
							xmlns="http://www.microsoft.com/GroupPolicy/PolicyDefinitions">

	<displayName>PDF-XChange Driver ADMX File</displayName>
	<description>ADMX file for PDF-XChange Driver</description>
	<resources>
		<stringTable>
			<string id="PDFXDriver">PDF-XChange: Driver</string>
			<string id="PDFXDriver1">PDF-XChange Driver 10.1</string>
			<string id="PDFXDriver2">PDF-XChange Driver 10.1.0</string>

			<string id="SupportedOn_1011">PDF-XChange Driver v10.1.1 or later</string>

			<string id="Cat_PDFXDriver_1">PDF-XChange: Driver</string>
			<string id="Cat_Registration_1">Registration</string>

			<string id="Policy_CanCopySerial">Allow Copy Serial Keys</string>
			<string id="Policy_CanCopySerial_exp">Specifies if user is allowed to copy serial keys to the clipboard from the About->Registration dialog.</string>

			<string id="Policy_CanDeleteSerial">Allow Delete Serial Keys</string>
			<string id="Policy_CanDeleteSerial_exp">Specifies if user is allowed to delete serial keys using the About->Registration dialog.</string>

			<string id="Policy_CanAddSerial">Allow Add Serial Keys</string>
			<string id="Policy_CanAddSerial_exp">Specifies if user is allowed to add serial keys using the About->Registration dialog.</string>
		</stringTable>
	</resources>
</policyDefinitionResources>
