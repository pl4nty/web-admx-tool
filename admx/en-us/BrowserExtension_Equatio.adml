  <displayName>Equatio</displayName>
  <description>Policies for the Equatio browser extension, generated from its managed storage schema</description>
  <resources>
    <stringTable>
      <string id="extension_features_prediction">Prediction feature</string>
      <string id="extension_features_prediction_Explain">This enables or disables prediction / autocomplete suggestions from showing when typing in the Equation editor.

Default: true</string>
      <string id="extension_features_equation">Equation Drawer</string>
      <string id="extension_features_equation_Explain">Show/hide the Equation input button on the toolbar. This will stop the Equation editor drawer from being accessed.

Default: true</string>
      <string id="extension_features_latex">LaTeX Drawer</string>
      <string id="extension_features_latex_Explain">Show/hide the LaTeX input button on the toolbar. This will stop the LaTeX drawer from being accessed.

Default: true</string>
      <string id="extension_features_graph">Graph Drawer</string>
      <string id="extension_features_graph_Explain">Show/hide the graph input button on the toolbar. This will stop the graph drawer from being accessed.

Default: true</string>
      <string id="extension_features_handwriting">Handwriting Drawer</string>
      <string id="extension_features_handwriting_Explain">Show/hide the handwriting input button on the toolbar. This will stop the handwriting drawer from being accessed.

Default: true</string>
      <string id="extension_features_speech">Speech Drawer</string>
      <string id="extension_features_speech_Explain">Show/hide the speech input button on the toolbar. This will stop the speech input drawer from being accessed.

Default: true</string>
      <string id="extension_features_companion">Mobile Drawer</string>
      <string id="extension_features_companion_Explain">Show/hide the Equatio mobile button on the toolbar. This will stop the mobile drawer from being accessed.

Default: true</string>
      <string id="extension_features_equatio_mathspace">Mathspace Inserts</string>
      <string id="extension_features_equatio_mathspace_Explain">Show/hide the insert mathspace button on the toolbar.

Default: true</string>
      <string id="extension_features_screenshot_reader">Screenshot Reader Feature</string>
      <string id="extension_features_screenshot_reader_Explain">Show/hide the screenshot reader button on the toolbar.

Default: true</string>
      <string id="extension_features_whiteboard">Whiteboard</string>
      <string id="extension_features_whiteboard_Explain">Show/hide the Whiteboard reader button on the toolbar.

Default: true</string>
      <string id="extension_features_stem_tools">STEM Tools</string>
      <string id="extension_features_stem_tools_Explain">Remove STEM Tools button from the toolbar. STEM Features such as the molecular viewer, periodic table and calculator.

Default: true</string>
      <string id="extension_features_forms_creator">Forms Creator</string>
      <string id="extension_features_forms_creator_Explain">Show/hide the Forms Creator button on the toolbar.

Default: true</string>
      <string id="extension_features_math_mentor">Math Mentor</string>
      <string id="extension_features_math_mentor_Explain">Show/hide the Math Mentor button in the Equation Editor.

Default: true</string>
      <string id="extension_features_ai_math_suggest">AI Math Suggestions</string>
      <string id="extension_features_ai_math_suggest_Explain">Show/hide the 'Refine with AI' (Math Suggestions) button in the Speech Input tool.

Default: true</string>
      <string id="extension_features_triangle_calculator">Triangle Calculator</string>
      <string id="extension_features_triangle_calculator_Explain">Show/hide the Triangle Calculator button on the toolbar.

Default: true</string>
      <string id="SUPPORTED_EXTENSION">Equatio browser extension</string>
      <string id="extension">Equatio</string>
      <string id="extension_features">features</string>
    </stringTable>
    <presentationTable/>
  </resources>
