<!-- Begin: Button "Large File Transfer" -->
	<!-- Begin: HKLM -->
		<string id="POL_SEPPmail_Computer_SMLargeFileTransfer">SMLargeFileTransfer</string>
		<string id="POL_SEPPmail_Computer_SMLargeFileTransfer_Help">Show "Large File Transfer" (LFT) button in ribbon of new e-mail.
(see also https://docs.seppmail.com/en/index.html?06_moa_07_large-file-transfer.htm)
default is "inactive"
		</string>

		<string id="POL_SEPPmail_Computer_SMLargeFileTransferSelected">SMLargeFileTransferSelected</string>
		<string id="POL_SEPPmail_Computer_SMLargeFileTransferSelected_Help">Activates "Large File Transfer" (LFT) button in ribbon of new e-mail by default.
If the associated button is not displayed, the function remains active!

default is "inactive"
		</string>
		
		<string id="POL_SEPPmail_Computer_SMLargeFileTransferBypass">SMLargeFileTransferBypass</string>
		<string id="POL_SEPPmail_Computer_SMLargeFileTransferBypass_Help">Defines whether the bypass mode should be used for large file transfer.
(see also https://docs.seppmail.com/en/index.html?03_wp_05_af_02_lft_03_add-in.htm)

default is "inactive"
		</string>

		<string id="POL_SEPPmail_Computer_LFTSEPPmailHostname">LFTSEPPmailHostname</string>
		<string id="POL_SEPPmail_Computer_LFTSEPPmailHostname_Help">Hostname of GINA domain, which has to be used for large file upload (Large File Transfer is needed and has to be configured on appliance)</string>

		<string id="POL_SEPPmail_Computer_InsecureLFTUploadConnection">InsecureLFTUploadConnection</string>
		<string id="POL_SEPPmail_Computer_InsecureLFTUploadConnection_Help">Allows unsecured large file upload when activated.

default is "inactive"
		</string>

		<string id="POL_SEPPmail_Computer_s-smlfm">s-smlfm</string>
		<string id="POL_SEPPmail_Computer_s-smlfm_Help">Defines the indicator that is to be set in the "Subject Mode" for the respective action in the subject of the e-mail.

The indicator set here for the action must correlate with the configuration in the "Ruleset Generator" of the appliance.
(see also https://docs.seppmail.com/de/index.html?07_mi_07_mp__mail-processing.htm#rg_lf_alwaysuselargefileprocessingformailswiththefollowingtextinsubject)

default is [lfm]
		</string>
	<!-- End: HKLM -->
	<!-- Begin: HCU -->
		<string id="POL_SEPPmail_User_SMLargeFileTransfer">SMLargeFileTransfer</string>
