			<textBox refId="TXT_SEPPmail_Computer_Tooltips_EN_Encrypt">
				<label>Encrypt</label>
				<defaultValue>Ensures secure transmission of e-mails over the Internet. This prevents unauthorized third parties from reading the e-mail.</defaultValue>
			</textBox>
		</presentation>
