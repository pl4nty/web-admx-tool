	< /End: HCU -->
<!-- End: Webmail -->

<!-- Begin: InternalEncryption -->
	<!-- Begin: HKLM -->
		<presentation id="POL_SEPPmail_Computer_Tooltips_DE_InternalEncryption">
			<textBox refId="TXT_SEPPmail_Computer_Tooltips_DE_InternalEncryption">
				<label>InternalEncryption</label>
				<defaultValue>Gewährleistet ein sicheres Übertragen von E-Mails auch im internen Firmennetz.</defaultValue>
			</textBox>
		</presentation>
	<!-- End: HKLM -->
	<!-- Begin: HCU>
