				<label>Sign</label>
				<defaultValue>Signs the e-mail and thus ensures the identity of the sender and the integrity of the e-mail for the recipient.</defaultValue>
			</textBox>
		</presentation>
	<!-- End: HKLM -->
	<!-- Begin: HCU>
