(Requires "Tooltips" to be defined in the respective language of Outlook installation)

default is "inactive"
		</string>
	< /End: HCU -->
<!-- End: "Tool tips" -->

<!-- Begin: "Warning" -->
	<!-- Begin: HKLM -->
		<string id="POL_SEPPmail_Computer_SMWarning">SMWarning</string>
