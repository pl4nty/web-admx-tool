				<label>Sign</label>
				<defaultValue>Signiert die E-Mail und stellt somit die Identität des Absenders, sowie die Integrität der E-Mail für den Empfänger sicher.</defaultValue>
			</textBox>
		</presentation>
	<!-- End: HKLM -->
