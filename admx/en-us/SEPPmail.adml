	</description>
	<resources>

	<stringTable>

	<!-- Begin: HKLM -->
		<string id="CAT_SEPPmail">SEPPmail</string>
		<string id="CAT_SEPPmail_Help">SEPPmail Outlook Add-In settings

Further information on how to configure this add-in via GPOs can be found under
	https://docs.seppmail.com/en/index.html?06_moa_05_registry.htm
		</string>
	<!-- End: HKLM -->

	<!-- Begin: HKLM -->
		<string id="CAT_SEPPmail_Computer">Computer</string>
		<string id="CAT_SEPPmail_Computer_Help">This category configures the values located under the [HKEY_LOCAL_MACHINE\SOFTWARE\Wow6432Node\SEPPmail\OutlookAddIn] key.
The values are machine-related.
Any additional user-related values that may be present are usually of higher value.
		</string>
	<!-- End: HKLM -->
	<!-- Begin: HCU -->
		<string id="CAT_SEPPmail_User">User</string>
		<string id="CAT_SEPPmail_User_Help">This category configures the values located under the [HKEY_CURRENT_USER\Software\OutlookAddIn] key.
The values are user-specific.
Existing user-related values are usually more significant than the machine-related values.
		</string>
	<!-- End: HCU -->

	<!-- Begin: HKLM -->
		<string id="CAT_SEPPmail_Computer_Tooltips">Tooltips</string>
		<string id="CAT_SEPPmail_Computer_Tooltips_Help">This category configures the values located under the [HKEY_LOCAL_MACHINE\SOFTWARE\Wow6432Node\SEPPmail\OutlookAddIn\Tooltips] key.</string>
	<!-- End: HKLM -->
	<!-- Begin: HCU>
		<string id="CAT_SEPPmail_User_Tooltips">Tooltips</string>
		<string id="CAT_SEPPmail_User_Tooltips_Help">This category configures the values located under the [HKEY_CURRENT_USER\Software\OutlookAddIn\Tooltips] key.</string>
	< /End: HCU -->

