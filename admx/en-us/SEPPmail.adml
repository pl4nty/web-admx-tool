<!-- Begin: Button description -->
<!-- Begin: Button "Encrypt" -->
	<!-- Begin: HKLM -->
		<string id="POL_SEPPmail_Computer_SMEncrypt">SMEncrypt</string>
		<string id="POL_SEPPmail_Computer_SMEncrypt_Help">Show "encrypt" button in ribbon of new e-mail.

default is "active"
		</string>

		<string id="POL_SEPPmail_Computer_SMEncryptSelected">SMEncryptSelected</string>
		<string id="POL_SEPPmail_Computer_SMEncryptSelected_Help">Activates "encrypt" button in ribbon of new e-mail by default.
If the associated button is not displayed, the function remains active!
	
default is "inactive"
		</string>

		<string id="POL_SEPPmail_Computer_s-smenc">s-smenc</string>
		<string id="POL_SEPPmail_Computer_s-smenc_Help">When Subject-Mode is activated this is the subject tag added by choosing Encrypt button.

The indicator set here for the action must correlate with the configuration in the "Ruleset Generator" of the appliance.
(see also https://docs.seppmail.com/de/index.html?07_mi_07_mp__mail-processing.htm#rg_e_oe_alwaysencryptmailswiththefollowingtextinsubject)

Default is [confidential]
		</string>
	<!-- End: HKLM -->
	<!-- Begin: HCU -->
		<string id="POL_SEPPmail_User_SMEncrypt">SMEncrypt</string>
		<string id="POL_SEPPmail_User_SMEncrypt_Help">Show "encrypt" button in ribbon of new e-mail.

default is "active
		</string>

		<string id="POL_SEPPmail_User_SMEncryptSelected">SMEncryptSelected</string>
		<string id="POL_SEPPmail_User_SMEncryptSelected_Help">Activates "encrypt" button in ribbon of new e-mail by default.
If the associated button is not displayed, the function remains active!

default is "inactive"
		</string>
		
		<string id="POL_SEPPmail_User_s-smenc">s-smenc</string>
		<string id="POL_SEPPmail_User_s-smenc_Help">When Subject-Mode is activated this is the subject tag added by choosing Encrypt button.

The indicator set here for the action must correlate with the configuration in the "Ruleset Generator" of the appliance.
(see also https://docs.seppmail.com/de/index.html?07_mi_07_mp__mail-processing.htm#rg_e_oe_alwaysencryptmailswiththefollowingtextinsubject)

Default is [confidential]
		</string>
	<!-- End: HCU -->
<!-- End: Button "Encrypt" -->
<!-- Begin: Button "Encrypt with read receipt" -->
	<!-- Begin: HKLM -->
