		<string id="POL_SEPPmail_User_InsecureLFTUploadConnection">InsecureLFTUploadConnection</string>
		<string id="POL_SEPPmail_User_InsecureLFTUploadConnection_Help">Allows unsecured large file upload when activated.

default is "inactive" (secure)
		</string>

		<string id="POL_SEPPmail_User_s-smlfm">s-smlfm</string>
