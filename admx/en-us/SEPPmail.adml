<!-- End: InternalEncryption -->

<!-- Begin: NoEncryption -->
	<!-- Begin: HKLM -->
		<presentation id="POL_SEPPmail_Computer_Tooltips_DE_NoEncryption">
			<textBox refId="TXT_SEPPmail_Computer_Tooltips_DE_NoEncryption">
				<label>NoEncryption</label>
				<defaultValue>Unterbindet das Verschlüsseln der E-Mail, sofern dies die firmeninterne Voreinstellung ist. Dies kann unter Umständen sinnvoll sein, wenn der Empfänger dies anfordert. Hintergrund können Probleme beim Öffnen der E-Mail auf Mobilen Endgeräten sein. Dabei ist unbedingt zu prüfen, ob der Inhalt der E-Mail ein unverschlüsseltes Versenden erlaubt! Gegebenenfalls ist das Verwenden von „Verschlüsseln mit Lesebestätigung" – und damit der Einsatz der GINA Technologie – zu bevorzugen, da dies auch auf Mobilen Endgeräten funktioniert.</defaultValue>
			</textBox>
		</presentation>
	<!-- End: HKLM -->
	<!-- Begin: HCU>
		<presentation id="POL_SEPPmail_User_Tooltips_DE_NoEncryption">
			<textBox refId="TXT_SEPPmail_User_Tooltips_DE_NoEncryption">
