<!-- Begin: Button "Internal encryption" -->
	<!-- Begin: HKLM -->
		<string id="POL_SEPPmail_Computer_SMInternalEncryption">SMInternalEncryption</string>
		<string id="POL_SEPPmail_Computer_SMInternalEncryption_Help">Shows "internal encryption" button in ribbon of new e-mail.

default is "inactive"
		</string>

		<string id="POL_SEPPmail_Computer_SMInternalEncryptionSelected">SMInternalEncryptionSelected</string>
		<string id="POL_SEPPmail_Computer_SMInternalEncryptionSelected_Help">Activates "internal encryption" button in ribbon of new e-mail by default.
If the associated button is not displayed, the function remains active!

default is "inactive"
		</string>

		<string id="POL_SEPPmail_Computer_InternalRecipient">InternalRecipient</string>
		<string id="POL_SEPPmail_Computer_InternalRecipient_Help">If the Internal Mail Encryption (IME) is activated (this must be configured on the appliance, see also https://docs.seppmail.com/en/index.html?03_wp_05_af_03_ime_01_e2e__end-to-end-encryption.htm),

ime@imepseudodomain activates IME V1.0 [default]
@ime.&lt;your-domain.tld&gt; activates IME V2.0
		</string>
	<!-- End: HKLM -->
	<!-- Begin: HCU -->
		<string id="POL_SEPPmail_User_SMInternalEncryption">SMInternalEncryption</string>
		<string id="POL_SEPPmail_User_SMInternalEncryption_Help">Shows "internal encryption" button in ribbon of new e-mail.
(see also https://docs.seppmail.com/de/index.html?06_moa_08_internal-encryption.htm)

default is "inactive"
		</string>

		<string id="POL_SEPPmail_User_SMInternalEncryptionSelected">SMInternalEncryptionSelected</string>
		<string id="POL_SEPPmail_User_SMInternalEncryptionSelected_Help">Activates "internal encryption" button in ribbon of new e-mail by default.
If the associated button is not displayed, the function remains active!

default is "inactive"
		</string>

		<string id="POL_SEPPmail_User_InternalRecipient">InternalRecipient</string>
		<string id="POL_SEPPmail_User_InternalRecipient_Help">If the Internal Mail Encryption (IME) is activated (this must be configured on the appliance, see also https://docs.seppmail.com/en/index.html?03_wp_05_af_03_ime_01_e2e__end-to-end-encryption.htm),

ime@imepseudodomain activates IME V1.0 [default]
@ime.&lt;your-domain.tld&gt; activates IME V2.0
		</string>
	<!-- End: HCU -->
<!-- End: Button "Internal encryption" -->
