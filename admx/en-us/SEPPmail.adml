default is "inactive"
		</string>

		<string id="POL_SEPPmail_Computer_SMWarningDomainWhitelist">SMWarningDomainWhitelist</string>
		<string id="POL_SEPPmail_Computer_SMWarningDomainWhitelist_Help">Recipient domains to which the warning message should be suppressed (separated by space).</string>
	<!-- End: HKLM -->
	<!-- Begin: HCU -->
