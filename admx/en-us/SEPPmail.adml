	<!-- Begin: "CategorisationHistory" -->
		<!-- Begin: HKLM -->
			<string id="POL_SEPPmail_Computer_CategorizeHistory">CategorizeHistory</string>
			<string id="POL_SEPPmail_Computer_CategorizeHistory_Help">Also categorise e-mails that have been processed since the last Outlook start (or initial from the beginning).

default is "inactive" (off)
			</string>
		<!-- End: HKLM -->
		<!-- Begin: HCU -->
			<string id="POL_SEPPmail_User_CategorizeHistory">CategorizeHistory</string>
			<string id="POL_SEPPmail_User_CategorizeHistory_Help">Also categorise e-mails that have been processed since the last Outlook start (or initial from the beginning).

default is "inactive" (off)
			</string>
		<!-- End: HCU -->
	<!-- End: "CategorisationHistory" -->
<!-- End: "Categorisation" -->

<!-- Begin: "Only HKLM config" -->
	<!-- Begin: HKLM -->
		<string id="POL_SEPPmail_Computer_LMonly">LMonly</string>
		<string id="POL_SEPPmail_Computer_LMonly_Help">Only use computer settings (user settings are ignored when activated!).

default is "inactive"
		</string>
	<!-- End: HKLM -->
	<!-- No HCU -->
<!-- End: "Only HKLM config" -->

<!-- Begin: "Position of subject tag" -->
		<string id="POL_SEPPmail_Computer_PlaceSubjectFlagsAtStart">PlaceSubjectFlagsAtStart</string>
		<string id="POL_SEPPmail_Computer_PlaceSubjectFlagsAtStart_Help">Specifies whether control commands are inserted at the beginning of the subject.

default is "inactive" (at the end)

This setting is only relevant if "subject-mod" is activated.
		</string>
	<!-- End: HKLM -->
	<!-- Begin: HCU -->
		<string id="POL_SEPPmail_User_PlaceSubjectFlagsAtStart">PlaceSubjectFlagsAtStart</string>
		<string id="POL_SEPPmail_User_PlaceSubjectFlagsAtStart_Help">Specifies whether control commands are inserted at the beginning of the subject.

default is "inactive" (at the end)

This setting is only relevant if "subject-mod" is activated.
		</string>
	<!-- End: HCU -->
<!-- End: "Position of subject tag" -->

<!-- Begin: "Subject mode" -->
	<!-- Begin: HKLM -->
		<string id="POL_SEPPmail_Computer_subject-mod">subject-mod</string>
		<string id="POL_SEPPmail_Computer_subject-mod_Help">Use subject tags instead of x-headers to triger kryptographic actions.

default is "inactive"
		</string>
	<!-- End: HKLM -->
	<!-- Begin: HCU -->
		<string id="POL_SEPPmail_User_subject-mod">subject-mod</string>
		<string id="POL_SEPPmail_User_subject-mod_Help">Use subject tags instead of x-headers to triger kryptographic actions.

default is "inactive"
		</string>
	<!-- End: HCU -->
<!-- End: "Subject mode" -->
<!-- Begin: "UsageTimeStamp" -->
	<!-- Begin: HKLM
		<string id="POL_SEPPmail_Computer_UsageTimeStamp">UsageTimeStamp</string>
		<string id="POL_SEPPmail_Computer_UsageTimeStamp_Help">Indicates the time of the last change in the machine settings</string>
	-->
	<!-- Begin: HCU -->
		<string id="POL_SEPPmail_User_UsageTimeStamp">UsageTimeStamp</string>
		<string id="POL_SEPPmail_User_UsageTimeStamp_Help">Indicates the time of the last change in the user settings

If this value is set to a point in time in the distant future, the acceptance of the machine settings is suppressed.
		</string>
	<!-- End: HCU -->
<!-- End: "UsageTimeStamp" -->
<!-- Begin: "Tool tips" -->
	<!-- Begin: HKLM -->

		<string id="POL_SEPPmail_Computer_Tooltips">Tooltips</string>
		<string id="POL_SEPPmail_Computer_Tooltips_Help">Show tooltips by positioning the mouse on a button in ribbon of new e-mail.
(Requires "Tooltips" to be defined in the respective language of Outlook installation)

default is "inactive"
		</string>
	<!-- End: HKLM -->
	<!-- Begin: HCU>
		<string id="POL_SEPPmail_User_Tooltips">Tooltips</string>
