<!-- Begin: Webmail -->
	<!-- Begin: HKLM -->
		<presentation id="POL_SEPPmail_Computer_Tooltips_IT_Webmail">
			<textBox refId="TXT_SEPPmail_Computer_Tooltips_IT_Webmail">
				<label>Webmail</label>
				<defaultValue>Forza l'uso della tecnologia GINA e garantisce quindi una conferma di lettura affidabile. Inoltre, questo metodo può offrire una migliore compatibilità con i dispositivi mobili.</defaultValue>
			</textBox>
