<!-- Begin: Encrypt -->
	<!-- Begin: HKLM -->
		<presentation id="POL_SEPPmail_Computer_Tooltips_DE_Encrypt">
			<textBox refId="TXT_SEPPmail_Computer_Tooltips_DE_Encrypt">
				<label>Encrypt</label>
				<defaultValue>Gewährleistet ein sicheres Übertragen von E-Mails über das Internet. Das Lesen der Mail durch unbefugte Dritte wird hiermit unterbunden.</defaultValue>
			</textBox>
		</presentation>
	<!-- End: HKLM -->
	<!-- Begin: HCU>
		<presentation id="POL_SEPPmail_User_Tooltips_DE_Encrypt">
