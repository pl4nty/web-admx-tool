<!-- End: LDAPPassword -->
<!-- Begin: LDAPAuthenticationTypes -->
	<!-- Begin: HKLM -->
		<string id="POL_SEPPmail_Computer_LDAPAuthenticationTypes">LDAPAuthenticationTypes</string>
		<string id="POL_SEPPmail_Computer_LDAPAuthenticationTypes_Help">Authentication method to use for LDAP logon.
Multiple values can be specified comma-separated.
Possible values are described in https://msdn.microsoft.com/dede/library/system.directoryservices.authenticationtypes(v=vs.110).aspx.
If the entry does not exist or is empty, NTLM authentication (secure) is used.

Possible settings:
- secure
- fast
- bind
		</string>
	<!-- End: HKLM -->
	<!-- Begin: HCU -->
		<string id="POL_SEPPmail_User_LDAPAuthenticationTypes">LDAPAuthenticationTypes</string>
		<string id="POL_SEPPmail_User_LDAPAuthenticationTypes_Help">Authentication method to use for LDAP logon.
Multiple values can be specified comma-separated.
Possible values are described in https://msdn.microsoft.com/dede/library/system.directoryservices.authenticationtypes(v=vs.110).aspx.
If the entry does not exist or is empty, NTLM authentication (secure) is used.

Possible settings:
- secure
- fast
- bind
		</string>
	<!-- End: HCU -->
<!-- End: LDAPAuthenticationTypes -->
<!-- Begin: LDAPOrganizationalUnit -->
	<!-- Begin: HKLM -->
		<string id="POL_SEPPmail_Computer_LDAPOrganizationalUnit">LDAPOrganizationalUnit</string>
		<string id="POL_SEPPmail_Computer_LDAPOrganizationalUnit_Help">LDAP OrganizationsUnit for which the query is executed, for example

OU=Users,DC=test,DC=server,DC=tld
		</string>
	<!-- End: HKLM -->
	<!-- Begin: HCU -->
		<string id="POL_SEPPmail_User_LDAPOrganizationalUnit">LDAPOrganizationalUnit</string>
		<string id="POL_SEPPmail_User_LDAPOrganizationalUnit_Help">LDAP OrganizationsUnit for which the query is executed, for example

OU=Users,DC=test,DC=server,DC=tld
		</string>
	<!-- End: HCU -->
<!-- End: LDAPOrganizationalUnit -->
<!-- Begin: LDAPQuery -->
	<!-- Begin: HKLM -->
		<string id="POL_SEPPmail_Computer_LDAPQuery">LDAPQuery</string>
		<string id="POL_SEPPmail_Computer_LDAPQuery_Help">LDAP query, in which the selected sender address is used instead of the placeholder {0}, if it exists and is authorized. Otherwise, no result will be returned.

Example:
(&amp;(mail={0})(SEPPmailPermission=*))
		</string>
	<!-- End: HKLM -->
	<!-- Begin: HCU -->
		<string id="POL_SEPPmail_User_LDAPQuery">LDAPQuery</string>
		<string id="POL_SEPPmail_User_LDAPQuery_Help">LDAP query, in which the selected sender address is used instead of the placeholder {0}, if it exists and is authorized. Otherwise, no result will be returned.

Example:
(&amp;(mail={0})(SEPPmailPermission=*))
		</string>
	<!-- End: HCU -->
<!-- End: LDAPQuery -->
<!-- End: LDAP configuration -->

