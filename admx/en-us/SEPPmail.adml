	< /End: HCU -->
<!-- End: InternalEncryption -->

<!-- Begin: NoEncryption -->
	<!-- Begin: HKLM -->
		<presentation id="POL_SEPPmail_Computer_Tooltips_EN_NoEncryption">
			<textBox refId="TXT_SEPPmail_Computer_Tooltips_EN_NoEncryption">
				<label>NoEncryption</label>
				<defaultValue>Prevents the e-mail from being encrypted, provided this is the company's default setting. This may make sense if the recipient requests it. This may be due to problems when opening the e-mail on mobile devices. It is essential to check whether the content of the e-mail allows unencrypted sending! If necessary, the use of "encryption with read confirmation" - and thus the use of GINA technology - should be preferred, since this also works on mobile devices.</defaultValue>
			</textBox>
		</presentation>
	<!-- End: HKLM -->
	<!-- Begin: HCU>
