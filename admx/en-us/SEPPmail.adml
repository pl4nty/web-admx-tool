		<string id="POL_SEPPmail_Computer_LDAPPassword">LDAPPassword</string>
		<string id="POL_SEPPmail_Computer_LDAPPassword_Help">Password of the user that is authorized to query the LDAP.</string>
	<!-- End: HKLM -->
