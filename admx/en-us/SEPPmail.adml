<!-- Begin: InternalEncryption -->
	<!-- Begin: HKLM -->
		<presentation id="POL_SEPPmail_Computer_Tooltips_EN_InternalEncryption">
			<textBox refId="TXT_SEPPmail_Computer_Tooltips_EN_InternalEncryption">
				<label>InternalEncryption</label>
				<defaultValue>Ensures secure transmission of e-mails even in the internal company network.</defaultValue>
			</textBox>
		</presentation>
	<!-- End: HKLM -->
	<!-- Begin: HCU>
		<presentation id="POL_SEPPmail_User_Tooltips_EN_InternalEncryption">
