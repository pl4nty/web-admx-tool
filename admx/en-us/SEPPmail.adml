	< /End: HCU -->
<!-- End: Encrypt -->

<!-- Begin: Webmail -->
	<!-- Begin: HKLM -->
		<presentation id="POL_SEPPmail_Computer_Tooltips_DE_Webmail">
			<textBox refId="TXT_SEPPmail_Computer_Tooltips_DE_Webmail">
				<label>Webmail</label>
				<defaultValue>Erzwingt das Verwenden der GINA Technologie und gewährleistet somit eine zuverlässige Lesebestätigung. Weiterhin bietet diese Methode unter Umständen eine bessere Kompatibilität zu Mobilen Endgeräten.</defaultValue>
			</textBox>
		</presentation>
	<!-- End: HKLM -->
	<!-- Begin: HCU>
		<presentation id="POL_SEPPmail_User_Tooltips_DE_Webmail">
