<!-- Begin: Webmail -->
	<!-- Begin: HKLM -->
		<presentation id="POL_SEPPmail_Computer_Tooltips_EN_Webmail">
			<textBox refId="TXT_SEPPmail_Computer_Tooltips_EN_Webmail">
				<label>Webmail</label>
				<defaultValue>Forces the use of GINA technology and thus guarantees a reliable read confirmation. Furthermore, this method may offer better compatibility with mobile devices.</defaultValue>
			</textBox>
		</presentation>
	<!-- End: HKLM -->
