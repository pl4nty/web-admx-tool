      <string id="CSE_TRACEFILEPATHPLANNING">Planning trace</string>
      <string id="CSE_TRACEFILEMAXSIZE">Maximum size of trace file (KB)</string>
      <string id="CSE_TRACELEVELNORMAL">Off</string>
      <string id="CSE_TRACELEVELVERBOSE">On</string>
      <string id="CSE_BACKGROUNDPRIORTYLEVEL">Background priority</string>
      <string id="CSE_PRILEVEL_NORMAL">Normal</string>
      <string id="CSE_PRILEVEL_BELOWNORMAL">Below Normal</string>
      <string id="CSE_PRILEVEL_LOWEST">Lowest</string>
