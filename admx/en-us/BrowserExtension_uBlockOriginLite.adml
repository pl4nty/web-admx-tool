  <description>Policies for the uBlock Origin Lite browser extension, generated from its managed storage schema</description>
  <resources>
    <stringTable>
      <string id="extension_defaultFiltering">The default filtering mode</string>
      <string id="extension_defaultFiltering_Explain">Can be one of &quot;none&quot;, &quot;basic&quot;, &quot;optimal&quot;, &quot;complete&quot;.</string>
      <string id="extension_disabledFeatures">User interface features to disable</string>
      <string id="extension_disabledFeatures_Explain">A list of tokens, each of which correspond to a user interface feature to disable.</string>
      <string id="extension_disableFirstRunPage">Disable first run page</string>
      <string id="extension_noFiltering">List of domains for which no filtering should occur</string>
      <string id="extension_rulesets">Rulesets to add/remove</string>
      <string id="extension_rulesets_Explain">Prefix a ruleset id with '+' to add, or '-' to remove. Use '-*' to disable all non-default lists.</string>
      <string id="extension_popupBlockMode">Enable/disable pop-up blocking</string>
      <string id="extension_showBlockedCount">Enable/disable toolbar icon count badge</string>
      <string id="extension_strictBlockMode">Enable/disable strict blocking</string>
      <string id="SUPPORTED_EXTENSION">uBlock Origin Lite browser extension</string>
      <string id="extension">uBlock Origin Lite</string>
