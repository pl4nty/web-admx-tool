    <presentationTable>
    
	  <presentation id="expl_ACFeatureEnablement">
	    <dropdownList noSort="true" refId="ACFeatureEnablement" defaultItem="0">Escolha uma dessas opções para o recurso:</dropdownList>
      </presentation>
	  
	  <presentation id="expl_Monday">	
		<text>Configurar a hora de início do dia:</text>
         <decimalTextBox refId="ACMondayStartOfDayHour" defaultValue="0" spinStep="1">Hora</decimalTextBox>
