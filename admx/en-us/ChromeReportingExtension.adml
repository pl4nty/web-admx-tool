<?xml version="1.0" ?><policyDefinitionResources revision="1.0" schemaVersion="1.0"><displayName/><description/><resources><stringTable><string id="SUPPORTED_WIN7">Microsoft Windows 7 or later</string><string id="extension">Chrome Reporting Extension</string><string id="report_user_id_data">Report User Identification Information</string><string id="report_user_id_data_Explain">Determines whether information that can be used to identify users should be gathered. This includes OS login and Chrome Profile login data. If this policy is set to enabled or not set user identifying data will be gathered. If the policy is set to disabled no user identifying data will be gathered.</string><string id="report_user_browsing_data">Report User Browsing Behavior Information</string><string id="report_user_browsing_data_Explain">Determines whether to track user browsing behavior. If this policy is set to enabled, extensive browsing behavior data is collected.  Otherwise no data is collected.</string><string id="log_to_eventlog">Write Logging Data to the Event Log</string><string id="log_to_eventlog_Explain">Determines whether the reporting should be also written to the windows system event log. If this policy is set to enabled logging data will be also written to the system event log.  If the policy is set to disabled or not set the data will only be written to the log file on disk.</string><string id="report_machine_id_data">Report Machine Identification Information</string><string id="report_machine_id_data_Explain">Determines whether information that can be used to identify machines should be gathered. This includes machine name and network addresses. If this policy is set to enabled or not set machine identifying data will be gathered. If the policy is set to disabled no machine identifying data will be gathered.</string><string id="report_extensions_data">Report Extension and Plugin Information</string><string id="report_extensions_data_Explain">Determines whether extensions and plugins related information should be gathered. If this policy is set to enabled or not set extensions and plugins data will be gathered. If the policy is set to disabled no extension data will be gathered.</string><string id="cloud_reporting_frequency">Frequency of data reports to the Google Admin Console</string><string id="cloud_reporting_frequency_Explain">Determines how often a new set of logs should be sent up to the server specified in milliseconds. The default is 24 hours (86400000ms) and the value is in the range of 3h (10800000ms) to 7days (604800000ms). If the policy is set - the defined value is used unless it is outside of the specified range in which case the minimum or maximum allowed values are used. If the value is lef unset the default value of 24h is used.</string><string id="cloud_reporting_enabled">Enable reporting data to Google Amdin Console</string><string id="cloud_reporting_enabled_Explain">Determines whether the reporting should also be send to the Google Admin Console. This allows you to use the admin console for monitoring your Chrome deployments in the cloud. If the policy is set to enabled or not set, logging to the Google Admin Console is turned on for devices that are enrollmed for cloud policy. If the policy is disabled, logging data will only be written to the log file on disk.</string><string id="report_policy_data">Report Chrome Policy Information</string><string id="report_policy_data_Explain">Determines whether Chrome policy information should be gathered. If this policy is set to enabled or not set Chrome policy data will be gathered. If the policy is set to disabled no Chrome policy data will be gathered.</string><string id="report_version_data">Report OS and Chrome Version Information</string><string id="report_version_data_Explain">Determines whether OS and Chrome versions should be gathered. If this policy is set to enabled or not set version data will be gathered. If the policy is set to disabled no version information will be gathered.</string><string id="report_system_telemetry_data">Report System Telemetry Information</string><string id="report_system_telemetry_data_Explain">Determines whether system telemetry related information should be gathered. This includes CPU and Memory load as well as Chrome crash information. If this policy is set to enabled or not set system telemetry data will be gathered. If the policy is set to disabled no system telemetry data will be gathered.</string><string id="report_safe_browsing_data">Report Safe Browsing Events</string><string id="report_safe_browsing_data_Explain">Determines whether Safe Browsing data should be reported. This includes security interstitials and related events, dangerous downloads or corporate password reuse and changes. If this policy is set to enabled then Safe Browsing data will be gathered. If this policy is set to disabled or not set no Safe Browsing events will be gathered.</string><string id="report_reporting_api_data">Report Reporting API Events</string><string id="report_reporting_api_data_Explain">Determines whether Reporting API events should be reported. This policy only takes effect if the 'report_user_browsing_data' policy is enabled.</string></stringTable><presentationTable><presentation id="report_user_id_data"/><presentation id="report_user_browsing_data"/><presentation id="log_to_eventlog"/><presentation id="report_machine_id_data"/><presentation id="report_extensions_data"/><presentation id="cloud_reporting_frequency"><decimalTextBox refId="cloud_reporting_frequency_Part">Frequency of data reports to the Google Admin Console</decimalTextBox></presentation><presentation id="cloud_reporting_enabled"/><presentation id="report_policy_data"/><presentation id="report_version_data"/><presentation id="report_system_telemetry_data"/><presentation id="report_safe_browsing_data"/><presentation id="report_reporting_api_data"/></presentationTable></resources></policyDefinitionResources>