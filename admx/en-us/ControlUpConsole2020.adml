			<presentation id="Policy_Regulate_information_46" >
				<text >What are the maximum number of concurrent transactions processes by ControlUp Monitor? (0 = unlimited)</text>
				<decimalTextBox refId="Policy_Numeric_ElementRegulate_information_49" spinStep="1" spin="true" defaultValue="100" />
				<text />
				<text >What is the time interval in seconds used by ControlUp Monitor when collecting data from managed resources?</text>
