<?xml version="1.0" encoding="utf-8"?>
<policyDefinitionResources revision="1.0" schemaVersion="1.0" xmlns="http://www.microsoft.com/GroupPolicy/PolicyDefinitions">
  <!--axe DevTools Google Chrome extension lhdoppojpmngadmnindnejefpokejbdd version: 4.138.0-->
  <displayName>axe DevTools (Google Chrome)</displayName>
  <description>Policies for the axe DevTools extension for Google Chrome, generated from its managed storage schema</description>
  <resources>
    <stringTable>
      <string id="extension_AxeURL">The axe server url to point the extension at</string>
      <string id="extension_AxeURL_Explain">Set to full url of your axe DevTools server</string>
      <string id="extension_UsageServiceURL">Usage Service URL endpoint</string>
      <string id="extension_UsageServiceURL_Explain">The url of the Usage Service to have data collected and sent to.</string>
      <string id="extension_UsageServiceOrganization">Usage Service Organization</string>
      <string id="extension_UsageServiceOrganization_Explain">The organization name to send to the Usage Service.</string>
      <string id="extension_UsageServiceDepartment">Usage Service Department</string>
      <string id="extension_UsageServiceDepartment_Explain">The department name to send to the Usage Service.</string>
      <string id="extension_UsageServiceApplication">Usage Service Application</string>
      <string id="extension_UsageServiceApplication_Explain">The application name to send to the Usage Service.</string>
      <string id="extension_DataGather">Send usage data to the provided usage server</string>
      <string id="extension_DataGather_Explain">If set to true, usage data will be collected and sent to our usage server</string>
      <string id="extension_DisableIGT">Disable Intelligent Guided Testing in the extension</string>
      <string id="extension_DisableIGT_Explain">If set to true, no Intelligent Guided Tests will be rendered anywhere in the extension</string>
      <string id="extension_EnableIssueScreenshots">Capture screenshots of created issues</string>
      <string id="extension_EnableIssueScreenshots_Explain">If set to true, screenshots will be captured when issues are created</string>
      <string id="extension_WCAGLevel">A WCAG version and level to filter issues by</string>
      <string id="extension_WCAGLevel_Explain">When set to a valid accessibility standard only issues matching the set standard will be displayed</string>
      <string id="extension_AccessibilityStandard">An accessibility standard to filter issues by</string>
      <string id="extension_AccessibilityStandard_Explain">When set to a valid accessibility standard only issues matching the set standard will be displayed</string>
      <string id="extension_AxeVersion">A valid axe version to use when scanning for automatic issues</string>
      <string id="extension_AxeVersion_Explain">When set to a valid axe version, the provided axe version will be used when scanning for automatic issues.</string>
      <string id="extension_IncludeNeedsReviewInIssueCount">Include needs review issues in automatic issue count</string>
      <string id="extension_IncludeNeedsReviewInIssueCount_Explain">If set to false, needs review issues will no longer be included in the automatic issue count.</string>
      <string id="extension_AutomaticColorContrastReview">Only allow manual automatic color contrast reviews</string>
      <string id="extension_AutomaticColorContrastReview_Explain">If set to &quot;manual&quot;, automatic color contrast reviews can only be run manually.</string>
      <string id="extension_EnableMachineLearning">Capture screenshots and send them to ML servers to be processed.</string>
      <string id="extension_EnableMachineLearning_Explain">If set to true, some IGTs use will use Machine Learning (ML) to optimize testing.</string>
      <string id="extension_EnableAutomaticColorContrast">Enables the automatic color contrast review tool</string>
      <string id="extension_EnableAutomaticColorContrast_Explain">If set to true, screenshots will be captured when the automatic color contrast tool is run.</string>
      <string id="extension_DisableAllScreenshots">Disables all optional screenshot capabilities</string>
      <string id="extension_DisableAllScreenshots_Explain">If set to true, features requiring screenshots will be disabled.</string>
      <string id="extension_DisableNeedsReview">Hides needs review issues entirely</string>
      <string id="extension_DisableNeedsReview_Explain">If set to true, needs review issues won't be seen anywhere and automatic color contrast tool will be disabled</string>
      <string id="extension_OfflineLicenseKey">Enables local persistence of data without access to an axe DevTools server</string>
      <string id="extension_OfflineLicenseKey_Explain">If set to valid license key, will persist all data locally and disable feature requiring an axe DevTools server.</string>
      <string id="extension_RequireLogin">Enables login requirement for the extension</string>
      <string id="extension_RequireLogin_Explain">If set to true, users will be required to log in to use the extension.</string>
      <string id="extension_HideSocialProviders">Enables hiding social login providers</string>
      <string id="extension_HideSocialProviders_Explain">If set to true, social login providers will not be shown in the login screen.</string>
      <string id="SUPPORTED_EXTENSION">axe DevTools extension for Google Chrome</string>
      <string id="extension">axe DevTools</string>
    </stringTable>
    <presentationTable>
      <presentation id="extension_AxeURL">
        <textBox refId="extension_AxeURL_Part">
          <label>The axe server url to point the extension at</label>
        </textBox>
      </presentation>
      <presentation id="extension_UsageServiceURL">
        <textBox refId="extension_UsageServiceURL_Part">
          <label>Usage Service URL endpoint</label>
        </textBox>
      </presentation>
      <presentation id="extension_UsageServiceOrganization">
        <textBox refId="extension_UsageServiceOrganization_Part">
          <label>Usage Service Organization</label>
        </textBox>
      </presentation>
      <presentation id="extension_UsageServiceDepartment">
        <textBox refId="extension_UsageServiceDepartment_Part">
          <label>Usage Service Department</label>
        </textBox>
      </presentation>
      <presentation id="extension_UsageServiceApplication">
        <textBox refId="extension_UsageServiceApplication_Part">
          <label>Usage Service Application</label>
        </textBox>
      </presentation>
      <presentation id="extension_WCAGLevel">
        <textBox refId="extension_WCAGLevel_Part">
          <label>A WCAG version and level to filter issues by</label>
        </textBox>
      </presentation>
      <presentation id="extension_AccessibilityStandard">
        <textBox refId="extension_AccessibilityStandard_Part">
          <label>An accessibility standard to filter issues by</label>
        </textBox>
      </presentation>
      <presentation id="extension_AxeVersion">
        <textBox refId="extension_AxeVersion_Part">
          <label>A valid axe version to use when scanning for automatic issues</label>
        </textBox>
      </presentation>
      <presentation id="extension_AutomaticColorContrastReview">
        <textBox refId="extension_AutomaticColorContrastReview_Part">
          <label>Only allow manual automatic color contrast reviews</label>
        </textBox>
      </presentation>
      <presentation id="extension_OfflineLicenseKey">
        <textBox refId="extension_OfflineLicenseKey_Part">
          <label>Enables local persistence of data without access to an axe DevTools server</label>
        </textBox>
      </presentation>
    </presentationTable>
  </resources>
</policyDefinitionResources>
