<?xml version="1.0" encoding="utf-8"?>
<policyDefinitionResources revision="1.0" schemaVersion="1.0" xmlns="http://www.microsoft.com/GroupPolicy/PolicyDefinitions">
  <!--DeepL fancfknaplihpclbhbpclnmmjcjanbaf version: 1.101.0 generator: ba5f4604ca2d-->
  <displayName>DeepL</displayName>
  <description>Policies for the DeepL browser extension, generated from its managed storage schema</description>
  <resources>
    <stringTable>
      <string id="extension_requireLogin">Login Wall</string>
      <string id="extension_requireLogin_Explain">Indicates whether the login wall should be set, requiring users to log in.</string>
      <string id="extension_suggestIdp">Suggest IDP</string>
      <string id="extension_suggestIdp_Explain">A string with the name of the identity provider to suggest for the user.</string>
      <string id="extension_customExtensionIcon">Replace Extension Icon</string>
      <string id="extension_customExtensionIcon_Explain">Indicates whether to replace the default extension icon with the one set up for DeepL Home if available.</string>
      <string id="extension_enforceSsoAutologin">Enforce SSO Autologin</string>
      <string id="extension_enforceSsoAutologin_Explain">Indicates whether to enforce SSO autologin, immediately forwarding the user to the SSO page instead of the onboarding</string>
      <string id="extension_skipOnboarding">Skip Onboarding</string>
      <string id="extension_skipOnboarding_Explain">If true, skips the onboarding flow after installation.</string>
      <string id="extension_disableFloatingIcon">Disable Floating Icon</string>
      <string id="extension_disableFloatingIcon_Explain">If true, completely disables the floating translation icon for both reading and writing. Users cannot re-enable it.</string>
      <string id="extension_disableFloatingIconByDefault">Disable Floating Icon by Default</string>
      <string id="extension_disableFloatingIconByDefault_Explain">If true, sets the floating translation icon to off by default for both reading and writing. Users can re-enable it from settings.</string>
      <string id="extension_preventFeedbackSurvey">Prevent Feedback Survey</string>
      <string id="extension_preventFeedbackSurvey_Explain">If true, prevents feedback survey popups from being shown.</string>
      <string id="extension_hideWrite">Hide Write</string>
      <string id="extension_hideWrite_Explain">Indicates whether to hide Write features from the UI, including Write icons, tabs, and upgrade options for Write</string>
      <string id="SUPPORTED_EXTENSION">DeepL browser extension</string>
      <string id="extension">DeepL</string>
    </stringTable>
    <presentationTable>
      <presentation id="extension_suggestIdp">
        <textBox refId="extension_suggestIdp_Part">
          <label>Suggest IDP</label>
        </textBox>
      </presentation>
    </presentationTable>
  </resources>
</policyDefinitionResources>
