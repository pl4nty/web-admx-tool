<?xml version="1.0" encoding="utf-8"?>
<policyDefinitionResources revision="1.0" schemaVersion="1.0" xmlns="http://www.microsoft.com/GroupPolicy/PolicyDefinitions">
  <!--Authenticator Browser Extension ocglkepbibnalbgmbachknglpdipeoio version: 8.0.1 generator: 048db1039928-->
  <displayName>Authenticator Browser Extension</displayName>
  <description>Policies for the Authenticator Browser Extension, generated from its managed storage schema</description>
  <resources>
    <stringTable>
      <string id="extension_disableInstallHelp">Disable opening help page on install</string>
      <string id="extension_disableInstallHelp_Explain">If set to true, then help page will not be opened on install.</string>
      <string id="extension_disableBackup">Disable 3rd party backup</string>
      <string id="extension_disableBackup_Explain">If set to true, then 3rd party backup options will be hidden. If 3rd party backup is already configured for a user this will not stop it.</string>
      <string id="extension_disableExport">Disable import / export menu</string>
      <string id="extension_disableExport_Explain">If set to true, then export buttons will be hidden.</string>
      <string id="extension_storageArea">Storage area</string>
      <string id="extension_storageArea_Explain">Set to 'sync' or 'local'. If set will force user to use specified storage area. This setting will not check if a user is currently using another storage space and may hide data.</string>
      <string id="extension_feedbackURL">Feedback URL</string>
      <string id="extension_feedbackURL_Explain">Change the URL the feedback button opens.</string>
      <string id="extension_enforcePassword">Enforce password</string>
      <string id="extension_enforcePassword_Explain">If set to true, then user will be prompted to set a password before adding an account (if none set) and the remove password button will be hidden.</string>
      <string id="extension_enforceAutolock">Enforce autolock</string>
      <string id="extension_enforceAutolock_Explain">If any value is set, then the user will not be able to change the autolock setting. Set to a number in minutes.</string>
      <string id="extension_passwordPolicy">Password policy</string>
      <string id="extension_passwordPolicy_Explain">A regular expression to test if the password meets the security requirements. No slashes are needed (e.g. use [A-Z]+, but not use /[A-Z]+/).</string>
      <string id="extension_passwordPolicyHint">Password policy hint</string>
      <string id="extension_passwordPolicyHint_Explain">Hint to show if the password doesn't meet the security requirements.</string>
      <string id="SUPPORTED_EXTENSION">Authenticator Browser Extension</string>
      <string id="extension">Authenticator Browser Extension</string>
    </stringTable>
    <presentationTable>
      <presentation id="extension_storageArea">
        <textBox refId="extension_storageArea_Part">
          <label>Storage area</label>
        </textBox>
      </presentation>
      <presentation id="extension_feedbackURL">
        <textBox refId="extension_feedbackURL_Part">
          <label>Feedback URL</label>
        </textBox>
      </presentation>
      <presentation id="extension_enforceAutolock">
        <textBox refId="extension_enforceAutolock_Part">
          <label>Enforce autolock</label>
        </textBox>
      </presentation>
      <presentation id="extension_passwordPolicy">
        <textBox refId="extension_passwordPolicy_Part">
          <label>Password policy</label>
        </textBox>
      </presentation>
      <presentation id="extension_passwordPolicyHint">
        <textBox refId="extension_passwordPolicyHint_Part">
          <label>Password policy hint</label>
        </textBox>
      </presentation>
    </presentationTable>
  </resources>
