  <displayName>KeePassXC-Browser</displayName>
  <description>Policies for the KeePassXC-Browser browser extension, generated from its managed storage schema</description>
  <resources>
    <stringTable>
      <string id="extension_settings_afterFillSorting">How to sort credentials after fill. Default: sortByMatchingCredentials</string>
      <string id="extension_settings_afterFillSortingTotp">How to sort credentials after fill for TOTP. Default: sortByRelevantEntry</string>
      <string id="extension_settings_autoCompleteUsernames">Use Autocomplete Menu to view credentials on web pages. Default: true</string>
      <string id="extension_settings_autoFillAndSend">Automatically fill HTTP Basic Auth entries. Default: false</string>
      <string id="extension_settings_autoFillSingleEntry">Automatically fill single credential entries. Default: false</string>
      <string id="extension_settings_autoFillRelevantCredential">Automatically fill relevant credential entries. Default: false</string>
      <string id="extension_settings_autoFillSingleTotp">Automatically fill single TOTP. Default: false</string>
      <string id="extension_settings_autoRetrieveCredentials">Automatically retrieve credentials. Default: true</string>
      <string id="extension_settings_autoSubmit">Automatically submit credentials. Default: false</string>
      <string id="extension_settings_bannerPosition">Where to position the Credential Banner. Default (top): 1</string>
      <string id="extension_settings_checkUpdateKeePassXC">When to check updates for KeePassXC. Default (never): 0</string>
      <string id="extension_settings_clearCredentialsTimeout">Clear credential info from tabs after timeout. Default (seconds): 10</string>
      <string id="extension_settings_colorTheme">Extension color scheme. Default: system</string>
      <string id="extension_settings_connectionMethod">Extension connection method. Default: nativemessaging</string>
      <string id="extension_settings_credentialSorting">How to sort matching credentials. Default: sortByGroupAndTitle</string>
      <string id="extension_settings_debugLogging">Enable debug logging. Default: false</string>
      <string id="extension_settings_defaultGroup">Default group for storing new credentials. Default: (empty)</string>
      <string id="extension_settings_defaultPasskeyGroup">Default group for storing new passkeys. Default: (empty)</string>
      <string id="extension_settings_defaultGroupAlwaysAsk">Always ask group when saving new credentials. Default: false</string>
      <string id="extension_settings_defined_custom_fields">Object key is the page URL.</string>
      <string id="extension_settings_downloadFaviconAfterSave">Downloads favicon in KeePassXC after credential is created. Default: false</string>
      <string id="extension_settings_passkeys">Enable support for passkeys. Default: false</string>
      <string id="extension_settings_passkeysFallback">Use passkeys fallback. Default: true</string>
      <string id="extension_settings_redirectAllowance">How many redirects are allowed after Credential Banner is hidden. Default: 1</string>
      <string id="extension_settings_saveDomainOnly">Saves only the domain for new credentials and/or web page specific settings. Default: true</string>
      <string id="extension_settings_showGettingStartedGuideAlert">Show getting started guide link on popup. Default: true</string>
      <string id="extension_settings_showGroupNameInAutocomplete">Show group name in Autocomplete Menu. Default: true</string>
      <string id="extension_settings_showLoginFormIcon">Show username icons on web pages. Default: true</string>
      <string id="extension_settings_showLoginNotifications">Show notifications for new logins. Default: true</string>
      <string id="extension_settings_showNotifications">Show notifications. Default: true</string>
      <string id="extension_settings_showOTPIcon">Show TOTP icons on web pages. Default: true</string>
      <string id="extension_settings_showTroubleshootingGuideAlert">Show troubleshooting guide alert on multiple reconnect attempts. Default: true</string>
      <string id="extension_settings_sitePreferences">sitePreferences</string>
      <string id="extension_settings_useCompactMode">Use compact mode with Autocomplete Menu. Default: false</string>
      <string id="extension_settings_useMonochromeToolbarIcon">Use monochrome icons in the toolbar. Default: false</string>
      <string id="extension_settings_useObserver">Use dynamic input field detection. Default: true</string>
      <string id="extension_settings_usePredefinedSites">Use predefined sites for compatibility. Default: true</string>
      <string id="extension_settings_usePasswordGeneratorIcons">Use password generator icons. Default: false</string>
      <string id="SUPPORTED_EXTENSION">KeePassXC-Browser browser extension</string>
