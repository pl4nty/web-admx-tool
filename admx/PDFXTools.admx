          <minorVersion name="PDFXTools8_0_335" displayName="$(string.PDFXTools5)" versionIndex="0"/>
        </majorVersion>
        <majorVersion name="PDFXTools9_0_1" displayName="$(string.PDFXTools6)" versionIndex="4">
          <minorVersion name="PDFXTool9_0_350" displayName="$(string.PDFXTools7)" versionIndex="0"/>
