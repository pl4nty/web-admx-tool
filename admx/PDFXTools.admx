        </majorVersion>
      </product>
		</products>
		<definitions>
			<definition name="SupportedOn_1" displayName="$(string.SupportedOn_1)">
				<and>
					<range ref="PDFXTools" minVersionIndex="1"/>
				</and>
			</definition>
			<definition name="SupportedOn_2" displayName="$(string.SupportedOn_2)">
				<and>
					<range ref="PDFXTools" minVersionIndex="2"/>
				</and>
