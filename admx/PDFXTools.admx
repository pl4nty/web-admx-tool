					xmlns="http://www.microsoft.com/GroupPolicy/PolicyDefinitions">

	<policyNamespaces>
		<target prefix="pdft" namespace="TrackerSoftware.PDFXTools.Policies" />
		<using prefix="products" namespace="Microsoft.Policies.Products"/>
	</policyNamespaces>
	
	<resources minRequiredRevision="1.0" fallbackCulture="en-us"/>

	<supportedOn>
		<products>
			<product name="PDFXTools" displayName="$(string.PDFXTools)">
				<majorVersion name="PDFXTools6_0_1" displayName="$(string.PDFXTools1)" versionIndex="1">
					<minorVersion name="PDFXTools6_0_318" displayName="$(string.PDFXTools2)" versionIndex="0"/>
				</majorVersion>
				<majorVersion name="PDFXTools6_0_2" displayName="$(string.PDFXTools1)" versionIndex="2">
					<minorVersion name="PDFXTools6_0_322" displayName="$(string.PDFXTools3)" versionIndex="0"/>
