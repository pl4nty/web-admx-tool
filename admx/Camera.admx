<?xml version="1.0" encoding="utf-16"?>
<policyDefinitions revision="1.0" schemaVersion="1.0">
    <policyNamespaces>
        <target prefix="Camera" namespace="Microsoft.Policies.Camera" />
        <using prefix="windows" namespace="Microsoft.Policies.Windows" />
    </policyNamespaces>
    <resources minRequiredRevision="1.0" />
    <categories>
        <category name="L_Camera_GroupPolicyCategory" displayName="$(string.L_Camera_GroupPolicyCategory)" >
            <parentCategory ref="windows:WindowsComponents" />
        </category>
    </categories>
    <policies>
    <policy name="L_AllowCamera" class="Machine" displayName="$(string.L_AllowCamera)" explainText="$(string.L_AllowCameraExplain)" key="software\Policies\Microsoft\Camera" valueName="AllowCamera">
        <parentCategory ref="L_Camera_GroupPolicyCategory" />
        <supportedOn ref="windows:SUPPORTED_Windows_10_0" />
        <enabledValue>
            <decimal value="1" />
        </enabledValue>
        <disabledValue>
            <decimal value="0" />
        </disabledValue>
    </policy>
    <policy name="ConfigureCameraOptions" class="Machine" displayName="$(string.L_ConfigureCameraOptions_Name)" explainText="$(string.L_ConfigureCameraOptions_Explain)" presentation="$(presentation.ConfigureCameraOptions)" key="software\Policies\Microsoft\Camera" valueName="ConfigureCameraOptions">
      <parentCategory ref="L_Camera_GroupPolicyCategory" />
      <supportedOn ref="windows:SUPPORTED_Windows_11_0_24H2" />
      <elements>
        <enum id="ConfigureCameraOptions_Dropdown" valueName="ConfigureCameraOptions">
          <item displayName="$(string.ConfigureCameraOptions_AutoShare)">
            <value>
              <decimal value="1" />
            </value>
          </item>
          <item displayName="$(string.ConfigureCameraOptions_SafeMode)">
            <value>
              <decimal value="2" />
            </value>
          </item>
        </enum>
      </elements>
    </policy>
  </policies>
</policyDefinitions>

