<policyDefinitions revision="1.0" schemaVersion="1.0">
  <policyNamespaces>
     <target prefix="DellBatteryExtender" namespace="Dell.DCPM.Policies.BatteryExtender" />
     <using prefix="Dell" namespace="Dell.DCPM.Policies" />
	 <using prefix="windows" namespace="Microsoft.Policies.Windows" />
  </policyNamespaces>
  <resources minRequiredRevision="1.0" />
    <supportedOn>
    <definitions>
      <definition name="SUPPORTED_DCPM" displayName="$(string.SUPPORTED_DCPM)">
      </definition>
    </definitions>
  </supportedOn>
  <categories>
	<category name="BatteryExtender" displayName="$(string.cname_BatteryExtender)">
      <parentCategory ref="Dell:DCPM" />
    </category>
  </categories>
	
  <policies>	
  
  <policy name="BEFeatureEnablement" class="Machine" displayName="$(string.BEFeatureEnablement)" explainText="$(string.expl_BEFeatureEnablement)" presentation="$(presentation.pol_DisableBatteryExtenderFeature)" key="SOFTWARE\Policies\Dell\CommandPowerManager" valueName="BEFeatureEnablementGroup" >
      <parentCategory ref="BatteryExtender" />
      <supportedOn ref="SUPPORTED_DCPM" />
	  <enabledValue>
        <string>True</string>
      </enabledValue>
      <disabledValue>
        <string>False</string>
      </disabledValue>
	  <enabledList>
        <item key="SOFTWARE\Policies\Dell\CommandPowerManager" valueName="BEPolicyVersion">
          <value>
            <string>1.0.0</string>
          </value>
        </item>        
      </enabledList>
      <elements>
		<boolean id="BEDisabled" valueName="BEDisabled" required="false">
			<trueValue>
				<string>True</string> 
			</trueValue>
			<falseValue>
				<string>False</string> 
			</falseValue>  
		</boolean>
      </elements>
    </policy>
  
	 </policies>
</policyDefinitions>
  