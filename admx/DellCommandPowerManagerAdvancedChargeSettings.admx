      <parentCategory ref="AdvancedCharge" />
      <supportedOn ref="SUPPORTED_DCPM" />
      <enabledValue>
        <string>True</string>
      </enabledValue>
      <disabledValue>
        <string>False</string>
      </disabledValue>
	  <enabledList>
        <item key="SOFTWARE\Policies\Dell\CommandPowerManager" valueName="ACPolicyVersion">
          <value>
            <string>1.0.0</string>
          </value>
        </item>         
      </enabledList>
      <elements>
        <enum id="ACFeatureEnablement"  valueName="ACFeatureEnablement" required="false">
          <item  displayName="$(string.ACFeatureOn)">
            <value>
              <decimal value="0" />
            </value>
          </item>
          <item  displayName="$(string.ACFeatureOff)">
            <value>
              <decimal value="1" />
            </value>
          </item>
          <item  displayName="$(string.ACFeatureRemove)">
            <value>
              <decimal value="2" />
            </value>
          </item>
        </enum>
      </elements>
    </policy>

