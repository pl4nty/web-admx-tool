			class="User"
			displayName="$(string.ConfigureReplyLinkExpirationTimeInDaysDisplayName)"
			explainText="$(string.ConfigureReplyLinkExpirationTimeInDaysExplainText)"
			key="Software\Policies\Net at Work GmbH\Net at Work MailGateway\Outlook AddIn"
			presentation="$(presentation.ReplyLinkExpirationTimeInDays)">
			<parentCategory ref="OutlookAddin" />
			<supportedOn ref="SUPPORTED_OutlookAddin92OrHigher" />
			<elements>
				<enum
					id="ReplyLinkExpirationTimeInDaysPresentation"
					valueName="ReplyLinkExpirationTimeInDays"
					required="true">
					<item displayName="$(string.ReplyLinkExpirationTimeInDaysNever)">
						<value>
							<decimal value="2147483647" />
						</value>
					</item>
					<item displayName="$(string.ReplyLinkExpirationTimeInDaysToday)">
						<value>
							<decimal value="0" />
						</value>
					</item>
					<item displayName="$(string.ReplyLinkExpirationTimeInDays1Day)">
						<value>
							<decimal value="1" />
						</value>
					</item>
					<item displayName="$(string.ReplyLinkExpirationTimeInDays2Days)">
						<value>
							<decimal value="2" />
						</value>
					</item>
					<item displayName="$(string.ReplyLinkExpirationTimeInDays3Days)">
						<value>
							<decimal value="3" />
						</value>
					</item>
					<item displayName="$(string.ReplyLinkExpirationTimeInDays5Days)">
						<value>
							<decimal value="5" />
						</value>
					</item>
					<item displayName="$(string.ReplyLinkExpirationTimeInDays7Days)">
						<value>
							<decimal value="7" />
						</value>
					</item>
					<item displayName="$(string.ReplyLinkExpirationTimeInDays10Days)">
						<value>
							<decimal value="10" />
						</value>
					</item>
					<item displayName="$(string.ReplyLinkExpirationTimeInDays14Days)">
						<value>
							<decimal value="14" />
						</value>
					</item>
					<item displayName="$(string.ReplyLinkExpirationTimeInDays1Month)">
						<value>
							<decimal value="30" />
						</value>
					</item>
					<item displayName="$(string.ReplyLinkExpirationTimeInDays2Month)">
						<value>
							<decimal value="60" />
						</value>
					</item>
					<item displayName="$(string.ReplyLinkExpirationTimeInDays3Month)">
						<value>
							<decimal value="90" />
						</value>
					</item>
					<item displayName="$(string.ReplyLinkExpirationTimeInDays4Month)">
						<value>
							<decimal value="120" />
						</value>
					</item>
					<item displayName="$(string.ReplyLinkExpirationTimeInDays6Month)">
						<value>
							<decimal value="180" />
						</value>
					</item>
					<item displayName="$(string.ReplyLinkExpirationTimeInDays1Year)">
						<value>
							<decimal value="365" />
						</value>
					</item>
				</enum>
			</elements>
		</policy>
