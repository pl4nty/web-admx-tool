						</value>
					</item>
					<item displayName="$(string.UILang12)">
						<value>
							<string>pt-BR</string>
						</value>
					</item>
					<item displayName="$(string.UILang13)">
						<value>
							<string>fi-FI</string>
						</value>
					</item>
					<item displayName="$(string.UILang14)">
